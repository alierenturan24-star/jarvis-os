# JARVIS yerel ayarlari. Bu dosyaya GERCEK anahtar yazmayin.
# START_JARVIS.bat ilk calismada bunu .env olarak kopyalar.

APP_NAME=JARVIS
LANGUAGE=Turkce
DEBUG=false

# 8 GB RAM'li bilgisayarda uzak API saglayicisi daha hafiftir.
# Kullanmak istediginiz EN AZ BIR saglayicinin anahtarini yalniz .env'e yazin.
DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Istege bagli alternatifler
AIML_API_KEY=
AIML_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Claude Code CLI istege baglidir. Kurulu ve giris yapilmis ise JARVIS onu
# kod gorevlerinde kontrollu olarak bulur. API anahtari gerekmez.
CLAUDE_CODE_TIMEOUT_SECONDS=180

# Yerel Ollama kullanmak isterseniz DEFAULT_PROVIDER=ollama yapin.
# 8 GB RAM icin kucuk model secin; ayni anda tek model calistirin.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Gercek para emri yoktur. YouTube yayinlama insan onayi gerektirir.
